function isSupport(member) {
  if (!member || !member.roles) return false;
  return member.roles.cache.some(r => SUPPORT_ROLE_IDS.includes(r.id));
}

async function createHtmlTranscript(channel) {
  const messages = await channel.messages.fetch({ limit: 100 });
  const sorted = messages.reverse();

  let html = `
<html>
<head>
<meta charset="utf-8">
<style>
body { font-family: Arial, sans-serif; background: #1e1e1e; color: #fff; padding: 20px; }
.container { max-width: 900px; margin: 0 auto; }
h2 { color: #4ea1ff; }
.msg { margin-bottom: 15px; padding: 10px; border-radius: 6px; background: #2a2a2a; }
.author { font-weight: bold; color: #ffd166; }
.time { color: #aaa; font-size: 12px; margin-left: 8px; }
.content { margin-top: 6px; white-space: pre-wrap; color: #e6e6e6; }
</style>
</head>
<body>
<div class="container">
<h2>Transcript van ${channel.name}</h2>
`;

  sorted.forEach(m => {
    const content = m.content ? m.content.replace(/</g, "&lt;").replace(/>/g, "&gt;") : "<i>Geen tekst</i>";
    html += `
  <div class="msg">
    <div><span class="author">${m.author.tag}</span><span class="time">${m.createdAt.toLocaleString()}</span></div>
    <div class="content">${content}</div>
  </div>
  `;
  });

  html += `
</div>
</body>
</html>
`;
  return html;
}

async function sendHtmlTranscriptToLog(channel, html) {
  const fileName = `${channel.name}-${Date.now()}.html`;
  const filePath = path.join(__dirname, fileName);
  fs.writeFileSync(filePath, html);

  for (const channelId of TRANSCRIPT_LOG_CHANNELS) {
    const logChannel = channel.guild.channels.cache.get(channelId);
    if (logChannel) {
      await logChannel.send({
        content: `📄 HTML Transcript van **${channel.name}**`,
        files: [filePath]
      }).catch(() => {});
    }
  }

  // Verwijder het tijdelijke bestand
  try { fs.unlinkSync(filePath); } catch (e) {}
}

// ─────────────────────────────────────────────
// INTERACTIONS (knoppen voor ticket aanmaken blijven)
// Slash commands voor staff acties worden afgehandeld hieronder
// ─────────────────────────────────────────────

client.on("interactionCreate", async (interaction) => {
  try {
    // ─────────────────────────────────────────────
    // Slash commands (chat input)
    // ─────────────────────────────────────────────
    if (interaction.isChatInputCommand()) {
      const cmd = interaction.commandName;

      // Controleer of gebruiker support is voor staff commands
      const staffOnlyCommands = ["claim", "close", "delete", "transcript", "closerequest"];
      if (staffOnlyCommands.includes(cmd) && !isSupport(interaction.member)) {
        return interaction.reply({ content: "❌ Je hebt geen permissie om dit te doen.", ephemeral: true });
      }

      // Zorg dat we in een ticketkanaal zitten (topic bevat opener id)
      const opener = interaction.channel.topic;
      if (!opener) {
        return interaction.reply({ content: "❌ Dit is geen ticket kanaal.", ephemeral: true });
      }

      // /claim
      if (cmd === "claim") {
        const oldName = interaction.channel.name;
        if (oldName.includes("claimed-by-")) {
          const parts = oldName.split("claimed-by-");
          const claimerName = parts[1] || "iemand";
          return interaction.reply({ content: `Dit ticket is al geclaimd door **${claimerName}**.`, ephemeral: true });
        }
        const claimer = interaction.user.username;
        await interaction.channel.setName(`${oldName}-claimed-by-${claimer}`);
        return interaction.reply({ content: `Je hebt dit ticket geclaimd.`, ephemeral: true });
      }

      // /close
      if (cmd === "close") {
        // Alleen support of ticket opener mag sluiten
        const openerId = interaction.channel.topic;
        const isOpener = interaction.user.id === openerId;
        if (!isSupport(interaction.member) && !isOpener) {
          return interaction.reply({ content: "❌ Alleen support of de ticket‑opener kan dit doen.", ephemeral: true });
        }

        await interaction.channel.permissionOverwrites.edit(openerId, {
          SendMessages: false
        }).catch(() => {});

        return interaction.reply({ content: "Ticket gesloten 🔒", ephemeral: true });
      }

      // /delete (maakt transcript en verwijdert)
      if (cmd === "delete") {
        await interaction.reply({ content: "Ticket wordt verwijderd en transcript wordt gemaakt 🗑️", ephemeral: true });

        // Maak transcript
        const html = await createHtmlTranscript(interaction.channel);
        await sendHtmlTranscriptToLog(interaction.channel, html);

        // Wacht even en verwijder kanaal
        setTimeout(() => {
          interaction.channel.delete().catch(() => {});
        }, 1500);
        return;
      }

      // /transcript (handmatig)
      if (cmd === "transcript") {
        await interaction.reply({ content: "Transcript wordt gemaakt en verzonden 📄", ephemeral: true });
        const html = await createHtmlTranscript(interaction.channel);
        await sendHtmlTranscriptToLog(interaction.channel, html);
        return;
      }

      // /closerequest (stuurt verzoek naar opener met knoppen)
      if (cmd === "closerequest") {
        const openerId = interaction.channel.topic;
        if (!openerId) return interaction.reply({ content: "❌ Dit is geen ticket kanaal.", ephemeral: true });

        const embed = new EmbedBuilder()
          .setTitle("🔒 Verzoek tot sluiten")
          .setDescription(`<@${openerId}> wil je bevestigen dat dit ticket gesloten mag worden?`)
          .setColor(0xffcc00);

        const row = new ActionRowBuilder().addComponents(
          new ButtonBuilder().setCustomId("close_yes").setLabel("Ja, sluiten").setStyle(ButtonStyle.Success),
          new ButtonBuilder().setCustomId("close_no").setLabel("Nee").setStyle(ButtonStyle.Danger)
        );

        await interaction.reply({ content: "Vraag verstuurd!", ephemeral: true });
        await interaction.channel.send({ embeds: [embed], components: [row] });
        return;
      }

      return;
    }

    // ─────────────────────────────────────────────
    // BUTTONS (alleen voor ticket aanmaken en close_yes/close_no)
    // ─────────────────────────────────────────────
    if (!interaction.isButton()) return;

    const onderwerpMap = {
      vragen: "Vragen",
      partner: "Partner",
      unban: "Unban Aanvraag",
      rank: "Rank Aanvraag",
      klachten: "Klachten"
    };

    // TICKET AANMAKEN (knoppen)
    if (onderwerpMap[interaction.customId]) {
      await interaction.deferReply({ ephemeral: true });

      const onderwerp = onderwerpMap[interaction.customId];
      const count = ticketCounters[interaction.customId]++;
      const ticketName = `${interaction.customId}-${count.toString().padStart(3, "0")}`;
      const supportRoles = SUPPORT_MAP[interaction.customId];

      const overwrites = [
        {
          id: interaction.guild.id,
          deny: [PermissionsBitField.Flags.ViewChannel]
        },
        {
          id: interaction.user.id,
          allow: [
            PermissionsBitField.Flags.ViewChannel,
            PermissionsBitField.Flags.SendMessages
          ]
        },
        ...supportRoles.map(roleId => ({
          id: roleId,
          allow: [
            PermissionsBitField.Flags.ViewChannel,
            PermissionsBitField.Flags.SendMessages
          ]
        }))
      ];

      const channel = await interaction.guild.channels.create({
        name: ticketName,
        type: ChannelType.GuildText,
        parent: CATEGORY_MAP[interaction.customId],
        permissionOverwrites: overwrites,
        topic: interaction.user.id // TICKET OPENER OPSLAAN
      });

      const embed = new EmbedBuilder()
        .setTitle(`📩 ${onderwerp} Ticket`)
        .setDescription(`Welkom ${interaction.user}, leg hier je ${onderwerp.toLowerCase()} uit.`)
        .setColor(0x5865f2);

      // Stuur alleen knoppen voor closerequest (optioneel) of laat leeg
      await channel.send({
        content: `${interaction.user} <@&${supportRoles[0]}>`,
        embeds: [embed]
      });

      await interaction.editReply({ content: `Je ${onderwerp} ticket is aangemaakt: ${channel}`, ephemeral: true });
      return;
    }

    // CLOSE REQUEST: JA
    if (interaction.customId === "close_yes") {
      const opener = interaction.channel.topic;
      if (interaction.user.id !== opener) {
        return interaction.reply({ content: "❌ Alleen de ticket-opener kan dit bevestigen.", ephemeral: true });
      }

      const modal = new ModalBuilder()
        .setCustomId("rating_modal")
        .setTitle("⭐ Geef een beoordeling");

      const ratingInput = new TextInputBuilder()
        .setCustomId("rating")
        .setLabel("Hoe beoordeel je de support? (1-5)")
        .setStyle(TextInputStyle.Short)
        .setRequired(true);

      const row = new ActionRowBuilder().addComponents(ratingInput);
      modal.addComponents(row);

      await interaction.showModal(modal);
      return;
    }

    // CLOSE REQUEST: NEE
    if (interaction.customId === "close_no") {
      const opener = interaction.channel.topic;
      if (interaction.user.id !== opener) {
        return interaction.reply({ content: "❌ Alleen de ticket-opener kan dit weigeren.", ephemeral: true });
      }

      await interaction.reply({ content: "Ticket blijft open.", ephemeral: true });
      return;
    }

  } catch (err) {
    console.error("Interaction error:", err?.message || err);
    if (interaction.deferred || interaction.replied) {
      interaction.editReply({ content: "Er ging iets mis bij deze actie." }).catch(() => {});
    } else {
      interaction.reply({ content: "Er ging iets mis bij deze actie.", ephemeral: true }).catch(() => {});
    }
  }
});

